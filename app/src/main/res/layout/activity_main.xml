<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/zain_black">

    <!-- TOP BAR -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/zainTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ZAIN"
                android:textColor="@color/zain_white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/zainSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERSONAL AI ASSISTANT"
                android:textColor="@color/zain_red"
                android:textSize="9sp"
                android:letterSpacing="0.18" />

        </LinearLayout>

        <TextView
            android:id="@+id/statusPill"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_status_pill"
            android:text="● ONLINE"
            android:textColor="@color/zain_white"
            android:textSize="11sp"
            android:letterSpacing="0.08" />

        <Button
            android:id="@+id/menuButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="@android:color/transparent"
            android:text="⋮"
            android:textColor="@color/zain_white"
            android:textSize="27sp" />

    </LinearLayout>


    <!-- ASSISTANT CORE -->

    <LinearLayout
        android:id="@+id/coreArea"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/zainCore"
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:gravity="center"
            android:background="@drawable/bg_zain_core"
            android:text="Z"
            android:textColor="@color/zain_white"
            android:textSize="52sp"
            android:textStyle="bold"
            android:elevation="12dp" />

        <TextView
            android:id="@+id/coreStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="SYSTEM READY"
            android:textColor="@color/zain_gray"
            android:textSize="10sp"
            android:letterSpacing="0.15" />

    </LinearLayout>


    <!-- WELCOME -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Good evening."
            android:textColor="@color/zain_white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/welcomeSubtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="What are we working on?"
            android:textColor="@color/zain_gray"
            android:textSize="15sp" />

    </LinearLayout>


    <!-- MESSAGES -->

    <ScrollView
        android:id="@+id/messageScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <LinearLayout
            android:id="@+id/messageContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="12dp" />

    </ScrollView>


    <!-- INPUT AREA -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@drawable/bg_assistant_input"
            android:hint="Ask ZAIN anything..."
            android:hintTextColor="@color/zain_muted"
            android:textColor="@color/zain_white"
            android:textColorHighlight="@color/zain_red"
            android:textSize="15sp"
            android:singleLine="true"
            android:imeOptions="actionSend"
            android:paddingStart="18dp"
            android:paddingEnd="18dp" />

        <Button
            android:id="@+id/voiceButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_voice_button"
            android:text="◉"
            android:textColor="@color/zain_white"
            android:textSize="20sp" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_voice_button"
            android:text="➤"
            android:textColor="@color/zain_white"
            android:textSize="20sp" />

    </LinearLayout>

</LinearLayout>